# 이 파일을 복사해 .env.local로 만들고 실제 값을 채워주세요.
#   cp .env.example .env.local

# 필수 — Anthropic 콘솔(https://console.anthropic.com/settings/keys)에서 발급받은 API 키
ANTHROPIC_API_KEY=sk-ant-your-key-here

# 선택 — 비워두면 기본값(claude-sonnet-5)을 사용합니다.
# 계정에서 사용 가능한 모델 ID가 다르다면 여기서 코드 수정 없이 교체할 수 있습니다.
# ANTHROPIC_CHAT_MODEL=claude-sonnet-5
# ANTHROPIC_REMINDER_MODEL=claude-sonnet-5

# 선택 — 기존 Memory 기반 Cross-Character Awareness(다른 캐릭터의 Shared Memory 내용을
# 확률로 간접 인지시키는 기능) on/off. 기본값은 true(켜짐)입니다.
# CROSS_CHARACTER_AWARENESS_ENABLED=false

# 선택 — Cross-Character Interaction Awareness(다른 캐릭터와 대화했다는 행동 사실을
# 실제 메시지 기록 기반으로 인식시키는 기능) on/off. 기본값은 true(켜짐)입니다.
# 데모 비교나 문제 발생 시 빠른 롤백을 위해 false로 끌 수 있습니다.
# CROSS_CHARACTER_INTERACTION_ENABLED=false

# 선택 — 위 기능이 켜져 있을 때, 다른 캐릭터와의 상호작용이 감지되면 반드시 한 번
# 언급하도록 강제하는 데모 전용 모드입니다. 기본값은 false입니다. 표현 방식은 여전히
# 캐릭터 성격이 정합니다. 데모 시연용으로만 true를 권장합니다.
# CROSS_CHARACTER_INTERACTION_DEMO_MODE=true
